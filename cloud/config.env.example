# ─────────────────────────────────────────────────────────────────────
# Cloud Configuration for SRNN / LTC Experiments
# ─────────────────────────────────────────────────────────────────────
# Copy this file to config.env and fill in your values:
#   cp config.env.example config.env
#
# config.env is gitignored — safe for project-specific values.
# ─────────────────────────────────────────────────────────────────────

# Google Cloud project ID (find via: gcloud config get-value project)
GCP_PROJECT=your-project-id

# GCS bucket for code, data, and results (will be created by setup_gcs.sh)
GCS_BUCKET=gs://srnn-experiments

# Default VM settings
GCP_ZONE=us-central1-a
GCP_MACHINE_TYPE=n4d-highmem-2          # 2 vCPU, 16 GB RAM — ~2x single-core perf vs e2
GCP_IMAGE_FAMILY=srnn-julia            # custom image name (built by build_image.sh)
GCP_USE_SPOT=true                      # use Spot VMs for ~60-70% cost savings

# Julia version to install on VM image
JULIA_VERSION=1.12.5

# Julia project path (relative to repo root)
JULIA_PROJECT=JuliaLang

# GitHub repo (used by VMs to clone code)
GITHUB_REPO=git@github.com:TomRichner/Intersect-LNNs-SRNNs.git
