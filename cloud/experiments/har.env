# HAR — Human Activity Recognition (UCI HAR Dataset)
# Classification, 6 classes, 561 features, seq_len=16
# Reference: Table 3 — "Activity recognition"
EXPERIMENT_NAME=har
TRAIN_SCRIPT=JuliaLang/scripts/train_har_srnn.jl
ARGS="--epochs 50 --size 32 --lr 0.005 --bs 128"
MACHINE_TYPE=n4d-highmem-2
N_SEEDS=5
